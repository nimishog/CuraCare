# Server
EXPRESS_BACKEND_URL=http://localhost:5000

# API Keys (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model IDs (optional - defaults shown)
GEMINI_TEXT_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_TRANSLATION_MODEL=gemini-3.5-live-translate-preview
GEMINI_VISION_MODEL=gemini-2.5-flash-native-audio-latest

# File Upload Limits
MAX_AUDIO_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10